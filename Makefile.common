# Sources and include paths of the core.
# Shared by Makefile and, in the future, jni/Android.mk.
# CORE_DIR must be set by the file that includes this one.

INCFLAGS := -I$(CORE_DIR)/libretro-common/include \
            -I$(CORE_DIR)/src

SOURCES_C := $(CORE_DIR)/src/sample_libretro.c

SOURCES_CXX :=
